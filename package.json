{
  "name": "@midst-press/midst-format",
  "private": true,
  "version": "0.5.0",
  "description": "The .midst file format: spec, converters between generations, and the conformance suite.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "provenance": "node conformance/provenance.cjs",
    "build:harness": "node conformance/build.mjs",
    "prepare": "node tools/install-hooks.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "trajectory": "node conformance/trajectory.cjs",
    "conformance": "node conformance/verify_all.cjs",
    "conformance:coverage": "node conformance/coverage.cjs",
    "markloss": "node conformance/markloss.cjs",
    "render-lines": "node conformance/render_lines.cjs fixtures --known conformance/render_lines.known.json",
    "shapes-fuzz": "node conformance/shapes_fuzz.cjs --seed 1 --n 5000",
    "shapes-fuzz:open-controls": "node conformance/shapes_fuzz.cjs --seed 1 --n 1000 --open-controls",
    "build:lib": "node tools/build-lib.mjs",
    "parity": "node conformance/parity.cjs",
    "consumer-ts46": "node tools/consumer-ts46.cjs",
    "reproducible": "node tools/reproducible.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/html": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "happy-dom": "20.14.6",
    "node-html-parser": "6.1.13",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.14",
    "typescript": "5.5.3",
    "typescript-4.6": "npm:typescript@4.6.3"
  },
  "comment_pins": "EXACT versions, no carets. ^2.5.4 resolves to 2.27.3 today and TipTap HTML generation is version-sensitive, so a caret verifies behaviour the editor does not have.",
  "overrides": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-bullet-list": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-dropcursor": "3.32.0",
    "@tiptap/extension-gapcursor": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-list-keymap": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/html": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0"
  }
}
