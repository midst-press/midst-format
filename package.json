{
  "name": "@midst-press/midst-format",
  "private": true,
  "version": "0.1.0",
  "description": "The .midst file format: spec, converters between generations, and the conformance suite.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "provenance": "node conformance/provenance.cjs",
    "build:harness": "node conformance/build.mjs",
    "prepare": "node tools/install-hooks.cjs",
    "test": "jest --coverage",
    "trajectory": "node conformance/trajectory.cjs",
    "conformance": "node conformance/verify_all.cjs",
    "conformance:coverage": "node conformance/coverage.cjs",
    "markloss": "node conformance/markloss.cjs",
    "render-lines": "node conformance/render_lines.cjs fixtures --known conformance/render_lines.known.json",
    "shapes-fuzz": "node conformance/shapes_fuzz.cjs --seed 1 --n 5000 --pos-known 5087/1034/7960/3821/0",
    "shapes-fuzz:open-controls": "node conformance/shapes_fuzz.cjs --seed 1 --n 1000 --open-controls"
  },
  "dependencies": {
    "@tiptap/core": "2.5.4",
    "@tiptap/html": "2.5.4",
    "@tiptap/pm": "2.5.4",
    "@tiptap/starter-kit": "2.5.4",
    "node-html-parser": "6.1.13"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10"
  },
  "comment_pins": "EXACT versions, no carets. ^2.5.4 resolves to 2.27.3 today and TipTap HTML generation is version-sensitive, so a caret verifies behaviour the editor does not have."
}
