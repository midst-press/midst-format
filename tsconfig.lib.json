{
  "compilerOptions": {
    "strict": true,
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@tiptap/html/server": [
        "node_modules/@tiptap/html/dist/server/index.d.cts"
      ]
    }
  },
  "include": [
    "src/history.ts",
    "src/extensions.ts",
    "src/convert.ts",
    "src/follow.ts",
    "src/buildLabel.ts"
  ]
}
